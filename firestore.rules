rules_version = '2';

// =============================================================================
// supplier-ledger — Firestore security rules
// Every permission in the spec is enforced HERE (the UI only mirrors it).
// Roles: owner | admin ("الإدارة") | entry ("مدخل البيانات").
// Amounts are integers in halalas. Dates are 'YYYY-MM-DD' strings.
// =============================================================================
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ----------------------------------------------------
    function docPath(p) { return /databases/$(database)/documents/$(p); }
    function signedIn() { return request.auth != null; }
    function userDoc() { return get(/databases/$(database)/documents/users/$(request.auth.uid)); }
    // Lockout key = sha256(lower(email)) as hex; the app computes the same value.
    function emailKey() {
      return hashing.sha256(request.auth.token.get('email', '').lower()).toHexString().lower();
    }
    // 5 failed sign-in / PIN attempts lock the account for EVERY role (owner
    // included) for 15 minutes after the last failure (owner decision
    // 2026-10-07), or until the owner unlocks it sooner.
    function lockoutPath() { return /databases/$(database)/documents/lockouts/$(emailKey()); }
    function stillLocked(d) {
      return d.fails >= 5 && request.time < d.lastFailAt + duration.value(15, 'm');
    }
    function lockedOut() {
      return exists(lockoutPath()) && stillLocked(get(lockoutPath()).data);
    }
    // The next failure count: +1, or 1 again once a lock has expired.
    function nextFails(d) { return d.fails >= 5 ? 1 : d.fails + 1; }
    // Exactly one failure is added to the caller's counter in this batch.
    function failureCounted() {
      return getAfter(lockoutPath()).data.lastFailAt == request.time
        && ((exists(lockoutPath()) && getAfter(lockoutPath()).data.fails == nextFails(get(lockoutPath()).data))
            || (!exists(lockoutPath()) && getAfter(lockoutPath()).data.fails == 1));
    }
    function userActive() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && userDoc().data.active == true;
    }
    // Quick unlock: while the user's screen is locked the rules refuse every
    // read and write of business data (see /screenLocks below).
    function screenPath(uid) { return /databases/$(database)/documents/screenLocks/$(uid); }
    function screenLocked() {
      return exists(screenPath(request.auth.uid)) && get(screenPath(request.auth.uid)).data.locked == true;
    }
    // Signed in, enabled, not locked out — the screen may still be locked.
    function isActiveRaw() { return userActive() && !lockedOut(); }
    function isActive() { return isActiveRaw() && !screenLocked(); }
    function myRole() { return userDoc().data.role; }
    function isOwner() { return isActive() && myRole() == 'owner'; }
    function isManager() { return isActive() && myRole() in ['owner', 'admin']; }
    function isEntryAssigned(accountId) {
      return isActive() && myRole() == 'entry' && accountId in userDoc().data.assignedAccounts;
    }
    // Archived accounts are closed to data-entry users (statement, entries,
    // links) until a manager restores them; only the account card stays
    // readable so the app knows to hide it instead of showing an error.
    function isEntryFor(accountId) {
      return isEntryAssigned(accountId)
        && get(/databases/$(database)/documents/accounts/$(accountId)).data.get('archived', false) == false
        && get(/databases/$(database)/documents/accounts/$(accountId)).data.get('deleted', false) == false;
    }
    function canAccess(accountId) { return isManager() || isEntryFor(accountId); }
    function settings() { return get(/databases/$(database)/documents/settings/app).data; }
    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }
    // A real-looking calendar date: year 2000–2099, month 01–12, day 01–31.
    // (30/31-day months are checked in the app; the rules cannot do calendars.)
    function isDate(v) {
      return v is string && v.matches('^20[0-9]{2}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$');
    }
    function hasText(v, max) { return shortText(v, max) && v.trim().size() > 0; }
    function shortText(v, max) { return v is string && v.size() <= max; }
    function stamped(d) { return d.createdBy == request.auth.uid && d.createdAt == request.time; }
    function touched(d) { return d.updatedBy == request.auth.uid && d.updatedAt == request.time; }

    // Every edit/delete of financial data must land with an audit record in the
    // same batch (enforced via getAfter).
    // The record must be NEW in this very write (an old or pre-made record
    // cannot be reused to cover another change).
    function audited(path) {
      return request.resource.data.auditId is string
        && request.resource.data.auditId != resource.data.get('auditId', '')
        && !exists(/databases/$(database)/documents/auditLog/$(request.resource.data.auditId))
        && existsAfter(/databases/$(database)/documents/auditLog/$(request.resource.data.auditId))
        && getAfter(/databases/$(database)/documents/auditLog/$(request.resource.data.auditId)).data.actor == request.auth.uid
        && getAfter(/databases/$(database)/documents/auditLog/$(request.resource.data.auditId)).data.path == path;
    }
    // …and, where the owner asked for it, a notification for the managers
    // (same id as the audit record; see /notifications).
    function notified() {
      return !exists(/databases/$(database)/documents/notifications/$(request.resource.data.auditId))
        && existsAfter(/databases/$(database)/documents/notifications/$(request.resource.data.auditId));
    }

    // ---------- users --------------------------------------------------------
    match /users/{uid} {
      function validUser(d) {
        return d.keys().hasOnly(['name', 'email', 'role', 'active', 'assignedAccounts',
                                 'createdAt', 'createdBy', 'updatedAt', 'updatedBy'])
          && hasText(d.name, 80)
          && shortText(d.email, 200)
          && d.active is bool
          && d.assignedAccounts is list && d.assignedAccounts.size() <= 200;
      }
      allow get: if signedIn() && (request.auth.uid == uid || isManager());
      allow list: if isManager();
      // Managers create admins / data-entry users. The owner is created only by
      // the bootstrap script (Admin SDK), never from the client.
      allow create: if isManager()
        && validUser(request.resource.data)
        && request.resource.data.role in ['admin', 'entry']
        && stamped(request.resource.data);
      // Managers edit non-owner users (role stays admin/entry).
      allow update: if isManager()
        && resource.data.role != 'owner'
        && uid != request.auth.uid
        && validUser(request.resource.data)
        && request.resource.data.role in ['admin', 'entry']
        && request.resource.data.email == resource.data.email
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdBy == resource.data.createdBy
        && touched(request.resource.data);
      // The owner may rename himself — nothing else (role/active are frozen).
      allow update: if isOwner()
        && uid == request.auth.uid
        && changed().hasOnly(['name', 'updatedAt', 'updatedBy'])
        && hasText(request.resource.data.name, 80)
        && touched(request.resource.data);
      allow delete: if false;
    }

    // ---------- settings (owner only) ---------------------------------------
    match /settings/app {
      allow get: if isActiveRaw();
      allow update: if isOwner()
        && changed().hasOnly(['linkMinutes', 'payerName', 'roleLabels', 'idleMinutes',
                              'idleCountdownSeconds', 'updatedAt', 'updatedBy'])
        && request.resource.data.linkMinutes is int
        && request.resource.data.linkMinutes >= 5 && request.resource.data.linkMinutes <= 1440
        && request.resource.data.idleMinutes is int
        && request.resource.data.idleMinutes >= 1 && request.resource.data.idleMinutes <= 240
        && request.resource.data.idleCountdownSeconds is int
        && request.resource.data.idleCountdownSeconds >= 5
        && request.resource.data.idleCountdownSeconds <= 120
        && hasText(request.resource.data.payerName, 100)
        && request.resource.data.roleLabels.keys().hasOnly(['owner', 'admin', 'entry'])
        && hasText(request.resource.data.roleLabels.owner, 40)
        && hasText(request.resource.data.roleLabels.admin, 40)
        && hasText(request.resource.data.roleLabels.entry, 40)
        && touched(request.resource.data);
      allow create, delete: if false;
    }

    // Written only by the backup job (Admin SDK).
    match /meta/{doc} {
      allow get: if isOwner();
      allow write: if false;
    }

    // ---------- failed sign-in counter (per email hash) ----------------------
    match /lockouts/{key} {
      function failOnly() {
        return changed().hasOnly(['fails', 'lastFailAt'])
          && request.resource.data.lastFailAt == request.time;
      }
      allow get: if isOwner() || (signedIn() && key == emailKey());
      // Anyone (the login page is unauthenticated) may add exactly one failure.
      allow create: if key.matches('^[0-9a-f]{64}$')
        && request.resource.data.keys().hasOnly(['fails', 'lastFailAt'])
        && request.resource.data.fails == 1
        && request.resource.data.lastFailAt == request.time;
      allow update: if !stillLocked(resource.data) && failOnly()
        && request.resource.data.fails == nextFails(resource.data);
      // A successful sign-in clears its own counter (only while not locked).
      allow update: if signedIn() && key == emailKey() && !stillLocked(resource.data)
        && changed().hasOnly(['fails']) && request.resource.data.fails == 0;
      // Reset by the user's own correct PIN in the unlock batch (the
      // /screenLocks rule checks the PIN; this one checks it is that batch).
      allow update: if signedIn() && key == emailKey()
        && changed().hasOnly(['fails']) && request.resource.data.fails == 0
        && get(screenPath(request.auth.uid)).data.locked == true
        && getAfter(screenPath(request.auth.uid)).data.locked == false;
      // The owner unlocks anyone else.
      allow update: if isOwner()
        && changed().hasOnly(['fails', 'unlockedAt', 'unlockedBy'])
        && request.resource.data.fails == 0
        && request.resource.data.unlockedAt == request.time
        && request.resource.data.unlockedBy == request.auth.uid;
      allow delete: if false;
    }

    // ---------- quick unlock (server-enforced screen lock) ------------------
    // proof = sha256("sl-pin:v1:" + uid + ":" + pin) computed in the app;
    // pins/{uid}.check = sha256(proof). Nobody can read pins or attempts, so the
    // 6-digit PIN cannot be brute-forced offline; online, every guess must first
    // be committed together with +1 on the 5-attempt counter, and only then can
    // a following write unlock with it (commit → reveal), so no guess is free.
    match /pins/{uid} {
      function recentLogin() {
        return request.time < timestamp.value(request.auth.token.auth_time * 1000) + duration.value(5, 'm');
      }
      allow read: if false;
      // Set / change the PIN: only within 5 minutes of entering the password.
      allow create, update: if isActive() && uid == request.auth.uid && recentLogin()
        && request.resource.data.keys().hasOnly(['check', 'updatedAt'])
        && request.resource.data.check is string
        && request.resource.data.check.matches('^[0-9a-f]{64}$')
        && request.resource.data.updatedAt == request.time
        && getAfter(screenPath(uid)).data.pinSet == true
        && getAfter(screenPath(uid)).data.pinAt == request.time;
      allow delete: if isActive() && uid == request.auth.uid
        && getAfter(screenPath(uid)).data.pinSet == false;
    }

    match /unlockAttempts/{uid} {
      allow read: if false;
      // Commit a guess: only while locked, and it costs one failed attempt.
      allow create, update: if userActive() && uid == request.auth.uid
        && !lockedOut()
        && get(screenPath(uid)).data.locked == true
        && request.resource.data.keys().hasOnly(['proof', 'at'])
        && request.resource.data.proof is string
        && request.resource.data.proof.matches('^[0-9a-f]{64}$')
        && request.resource.data.at == request.time
        && failureCounted();
      // Removed in the same batch that unlocks.
      allow delete: if signedIn() && uid == request.auth.uid
        && get(screenPath(uid)).data.locked == true
        && getAfter(screenPath(uid)).data.locked == false;
    }

    match /screenLocks/{uid} {
      function mine() { return signedIn() && uid == request.auth.uid; }
      function pinsPath() { return /databases/$(database)/documents/pins/$(uid); }
      function attemptPath() { return /databases/$(database)/documents/unlockAttempts/$(uid); }
      function activity(d) {
        return d.activeAt == request.time
          && d.activeBy is string && d.activeBy.size() >= 8 && d.activeBy.size() <= 64;
      }
      // pinVer: random id of the current PIN, so a fingerprint key made for an
      // older PIN is recognised as stale on every device.
      function pinFlag(d) {
        return d.pinSet is bool && d.pinSet == existsAfter(pinsPath()) && d.pinAt == request.time
          && d.pinVer is string && d.pinVer.size() <= 64
          && (d.pinSet == false || d.pinVer.size() >= 16);
      }
      function unlocking() {
        return resource.data.locked == true
          && changed().hasOnly(['locked', 'at', 'activeAt', 'activeBy'])
          && request.resource.data.locked == false
          && request.resource.data.at == request.time
          && activity(request.resource.data);
      }
      // The committed guess is newer than the lock and matches the PIN.
      function committedGuessOk() {
        return exists(attemptPath())
          && get(attemptPath()).data.at > resource.data.at
          && hashing.sha256(get(attemptPath()).data.proof).toHexString().lower()
             == get(pinsPath()).data.check
          && !existsAfter(attemptPath());
      }
      // A correct guess may be the 5th: the counter it raised is reset with it.
      function counterReset() {
        return !exists(lockoutPath())
          || ((!stillLocked(get(lockoutPath()).data)
               || get(lockoutPath()).data.lastFailAt == get(attemptPath()).data.at)
              && getAfter(lockoutPath()).data.fails == 0);
      }

      allow get: if mine();
      allow list, delete: if false;
      allow create: if isActive() && mine()
        && request.resource.data.keys().hasOnly(['locked', 'at', 'activeAt', 'activeBy', 'pinSet', 'pinAt', 'pinVer'])
        && request.resource.data.locked == false
        && request.resource.data.at == request.time
        && activity(request.resource.data)
        && pinFlag(request.resource.data);
      // «Last active» heartbeat (lets another device of the same user decide
      // not to lock the account while this one is in use).
      allow update: if isActive() && mine()
        && changed().hasOnly(['activeAt', 'activeBy'])
        && activity(request.resource.data);
      // PIN set / changed / removed (same batch as /pins).
      allow update: if isActive() && mine()
        && changed().hasOnly(['pinSet', 'pinAt', 'pinVer'])
        && pinFlag(request.resource.data);
      // Lock: only with a PIN to come back with.
      allow update: if isActive() && mine()
        && resource.data.pinSet == true && exists(pinsPath())
        && changed().hasOnly(['locked', 'at'])
        && request.resource.data.locked == true
        && request.resource.data.at == request.time;
      // Unlock with the PIN / fingerprint (both reveal the committed proof).
      allow update: if mine() && userActive() && unlocking()
        && committedGuessOk() && counterReset();
      // Unlock by signing in again with the password after the lock.
      allow update: if mine() && isActiveRaw() && unlocking()
        && request.auth.token.auth_time * 1000 > resource.data.at.toMillis();
    }

    // ---------- on-demand backup requests (picked up by GitHub Actions) ------
    match /backupRequests/{id} {
      allow read: if isManager();
      allow create: if isManager()
        && request.resource.data.keys().hasOnly(['requestedBy', 'requestedAt', 'status'])
        && request.resource.data.requestedBy == request.auth.uid
        && request.resource.data.requestedAt == request.time
        && request.resource.data.status == 'pending';
      allow update, delete: if false;
    }

    // ---------- voucher counter ---------------------------------------------
    // No gaps in voucher numbers (owner decision 2026-10-07): the counter moves
    // only together with the NEW payment entry that takes the number.
    match /counters/vouchers {
      function taker() {
        return /databases/$(database)/documents/accounts/$(request.resource.data.lastAccount)/entries/$(request.resource.data.lastEntry);
      }
      allow get: if isActive();
      allow update: if changed().hasOnly(['next', 'lastAccount', 'lastEntry'])
        && request.resource.data.next == resource.data.next + 1
        && request.resource.data.lastAccount is string
        && request.resource.data.lastAccount.matches('^[A-Za-z0-9_-]{1,64}$')
        && request.resource.data.lastEntry is string
        && request.resource.data.lastEntry.matches('^[A-Za-z0-9_-]{1,64}$')
        && !exists(taker())
        && getAfter(taker()).data.voucherNo == request.resource.data.next
        && isActive();
      allow create, delete: if false;
    }

    // ---------- audit log (append-only) -------------------------------------
    // A record is accepted only together with the change it describes: the
    // target (an account or one of its entries the writer can access) must
    // point at it in the same write, and `before` must be its real previous
    // state (for archive/unarchive: the previous archived flag).
    match /auditLog/{id} {
      function seg() { return request.resource.data.path.split('/'); }
      function target() {
        return seg().size() == 2
          ? /databases/$(database)/documents/accounts/$(seg()[1])
          : /databases/$(database)/documents/accounts/$(seg()[1])/entries/$(seg()[3]);
      }
      function beforeIsReal() {
        return request.resource.data.action in ['archive', 'unarchive']
          ? request.resource.data.before.keys().hasOnly(['archived'])
            && request.resource.data.before.archived == get(target()).data.get('archived', false)
          : request.resource.data.before == get(target()).data;
      }
      allow read: if isManager();
      allow create: if request.resource.data.keys().hasOnly(['actor', 'action', 'path', 'before', 'at'])
        && request.resource.data.actor == request.auth.uid
        && request.resource.data.at == request.time
        && request.resource.data.action in ['update', 'delete', 'restore', 'archive', 'unarchive']
        && request.resource.data.path is string
        && request.resource.data.path.matches('^accounts/[A-Za-z0-9_-]{1,64}(/entries/[A-Za-z0-9_-]{1,64})?$')
        && (request.resource.data.action in ['archive', 'unarchive'] ? seg().size() == 2
            : request.resource.data.action == 'update' ? seg().size() == 4 : true)
        && request.resource.data.before is map
        && getAfter(target()).data.get('auditId', '') == id
        && beforeIsReal();
      // No role check here on purpose: the target's own rule (which this write
      // must also pass, since it points at this record) checks the role and
      // the account. Repeating it would exceed the 1000-expression budget.
      allow update, delete: if false;
    }

    // ---------- notifications for the owner and managers -------------------
    // Written by whoever edits a signed voucher or an invoice, deletes (moves to
    // the trash) or restores an entry — in the same batch, tied to its audit
    // record, so it can be neither skipped nor forged. Read state is per user.
    match /notifications/{id} {
      function auditAfter() { return getAfter(/databases/$(database)/documents/auditLog/$(id)).data; }
      function entryPath(d) { return 'accounts/' + d.accountId + '/entries/' + d.entryId; }
      function validNotification(d) {
        return d.keys().hasOnly(['kind', 'accountId', 'entryId', 'accountName', 'title', 'changes',
                                 'actor', 'actorName', 'at', 'readBy'])
          && d.kind in ['signedEdit', 'invoiceEdit', 'delete', 'restore', 'accountDelete', 'accountRestore']
          && d.accountId is string && d.accountId.size() <= 64
          && d.entryId is string && d.entryId.size() <= 64
          && shortText(d.accountName, 120)
          && shortText(d.title, 120)
          && d.changes is list && d.changes.size() <= 8
          && d.actor == request.auth.uid
          && d.actorName == userDoc().data.name
          && d.at == request.time
          && d.readBy == [];
      }
      allow read: if isManager();
      // (Role checks happen on the entry write this notification belongs to.)
      // Kinds on an account itself (entryId == ''): accountDelete / accountRestore.
      function onAccount(d) { return d.kind in ['accountDelete', 'accountRestore']; }
      function acctP(d) { return /databases/$(database)/documents/accounts/$(d.accountId); }
      function entryP(d) { return /databases/$(database)/documents/accounts/$(d.accountId)/entries/$(d.entryId); }
      allow create: if validNotification(request.resource.data)
        && auditAfter().actor == request.auth.uid
        && (onAccount(request.resource.data)
            ? request.resource.data.entryId == ''
              && auditAfter().path == 'accounts/' + request.resource.data.accountId
              && auditAfter().action == (request.resource.data.kind == 'accountDelete' ? 'delete' : 'restore')
              && getAfter(acctP(request.resource.data)).data.auditId == id
            : auditAfter().path == entryPath(request.resource.data)
              && auditAfter().action == (request.resource.data.kind in ['signedEdit', 'invoiceEdit']
                                         ? 'update' : request.resource.data.kind)
              && (request.resource.data.kind != 'signedEdit'
                  || 'signature' in get(entryP(request.resource.data)).data)
              && (request.resource.data.kind != 'invoiceEdit'
                  || get(entryP(request.resource.data)).data.type == 'invoice')
              && getAfter(entryP(request.resource.data)).data.auditId == id)
        && request.resource.data.accountName == get(acctP(request.resource.data)).data.name;
      // Mark as read: add only yourself.
      allow update: if changed().hasOnly(['readBy'])
        && isManager()
        && !(request.auth.uid in resource.data.readBy)
        && request.resource.data.readBy.size() == resource.data.readBy.size() + 1
        && request.resource.data.readBy.toSet() == resource.data.readBy.toSet().union([request.auth.uid].toSet());
      allow delete: if false;
    }

    // ---------- trash: deleted entries of every account (managers) ----------
    match /{path=**}/entries/{entryId} {
      allow list: if isManager();
    }

    // ---------- accounts (suppliers / customers) ----------------------------
    match /accounts/{accountId} {
      function validAccount(d) {
        return d.keys().hasOnly(['name', 'phone', 'group', 'logo', 'deleted',
                                 'archived', 'archivedAt', 'archivedBy', 'auditId', 'deletedAt',
                                 'balance', 'entryCount', 'lastDate', 'totalsEntry', 'totalsAt',
                                 'createdAt', 'createdBy', 'updatedAt', 'updatedBy', 'legacyId'])
          && d.get('archived', false) is bool
          && hasText(d.name, 120)
          && d.phone is string && (d.phone == '' || d.phone.matches('^05[0-9]{8}$'))
          && d.group in ['suppliers', 'customers', 'general']
          && (!('logo' in d) || d.logo == null || (d.logo is bytes && d.logo.size() <= 81920))
          && d.deleted is bool;
      }
      allow get: if isManager() || isEntryAssigned(accountId);
      allow list: if isManager();
      allow create: if isManager()
        && validAccount(request.resource.data)
        && request.resource.data.deleted == false
        && !('archived' in request.resource.data)
        && !('auditId' in request.resource.data)
        && !('legacyId' in request.resource.data)
        && !('deletedAt' in request.resource.data)
        // A new account starts with zero running totals.
        && request.resource.data.balance == 0
        && request.resource.data.entryCount == 0
        && request.resource.data.lastDate == ''
        && !('totalsEntry' in request.resource.data)
        && !('totalsAt' in request.resource.data)
        && stamped(request.resource.data);
      allow update: if isManager()
        && validAccount(request.resource.data)
        && request.resource.data.get('balance', null) == resource.data.get('balance', null)
        && request.resource.data.get('entryCount', null) == resource.data.get('entryCount', null)
        && request.resource.data.get('lastDate', null) == resource.data.get('lastDate', null)
        && request.resource.data.get('totalsEntry', null) == resource.data.get('totalsEntry', null)
        && request.resource.data.get('totalsAt', null) == resource.data.get('totalsAt', null)
        && request.resource.data.get('deletedAt', null) == resource.data.get('deletedAt', null)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.deleted == resource.data.deleted
        && request.resource.data.get('auditId', null) == resource.data.get('auditId', null)
        && request.resource.data.get('legacyId', null) == resource.data.get('legacyId', null)
        && request.resource.data.get('archived', false) == resource.data.get('archived', false)
        && request.resource.data.get('archivedAt', null) == resource.data.get('archivedAt', null)
        && request.resource.data.get('archivedBy', null) == resource.data.get('archivedBy', null)
        && touched(request.resource.data);
      // Archive / restore from the archive (owner and managers), audited.
      // (Only the archive fields are checked, so an account migrated with an
      // old-format phone can still be archived.)
      allow update: if isManager()
        && changed().hasOnly(['archived', 'archivedAt', 'archivedBy', 'auditId', 'updatedAt', 'updatedBy'])
        && request.resource.data.archived is bool
        && request.resource.data.archived != resource.data.get('archived', false)
        && (request.resource.data.archived
            ? request.resource.data.archivedAt == request.time
              && request.resource.data.archivedBy == request.auth.uid
            : !('archivedAt' in request.resource.data) && !('archivedBy' in request.resource.data))
        && touched(request.resource.data)
        && audited('accounts/' + accountId);
      // Move to the trash / restore (owner and managers): audited + notified.
      // Its entries stay as they are and come back with it.
      allow update: if isManager()
        && changed().hasOnly(['deleted', 'deletedAt', 'auditId', 'updatedAt', 'updatedBy'])
        && request.resource.data.deleted is bool
        && request.resource.data.deleted != resource.data.deleted
        && (request.resource.data.deleted
            ? request.resource.data.deletedAt == request.time
            : !('deletedAt' in request.resource.data))
        && touched(request.resource.data)
        && audited('accounts/' + accountId)
        && notified();
      // Running totals (balance, live entries, latest date): moved by exactly
      // one entry change written in the same transaction. Anyone who may write
      // that entry may move them — and only by the entry's real difference.
      function entryAt(e) { return /databases/$(database)/documents/accounts/$(accountId)/entries/$(e); }
      function liveBefore(e) { return exists(entryAt(e)) && get(entryAt(e)).data.deleted == false; }
      function liveAfter(e) { return existsAfter(entryAt(e)) && getAfter(entryAt(e)).data.deleted == false; }
      function totalsMath(d) {
        return d.balance == resource.data.balance
              + (liveAfter(d.totalsEntry) ? getAfter(entryAt(d.totalsEntry)).data.signed : 0)
              - (liveBefore(d.totalsEntry) ? get(entryAt(d.totalsEntry)).data.signed : 0)
          && d.entryCount == resource.data.entryCount
              + (liveAfter(d.totalsEntry) ? 1 : 0) - (liveBefore(d.totalsEntry) ? 1 : 0)
          && d.lastDate == (liveAfter(d.totalsEntry)
                            && getAfter(entryAt(d.totalsEntry)).data.date > resource.data.lastDate
                              ? getAfter(entryAt(d.totalsEntry)).data.date : resource.data.lastDate);
      }
      allow update: if changed().hasOnly(['balance', 'entryCount', 'lastDate', 'totalsEntry', 'totalsAt'])
        && 'balance' in resource.data
        && request.resource.data.totalsAt == request.time
        && request.resource.data.totalsEntry is string
        && request.resource.data.totalsEntry.matches('^[A-Za-z0-9_-]{1,64}$')
        && totalsMath(request.resource.data)
        && canAccess(accountId);
      allow delete: if false;

      // ---------- entries ----------------------------------------------------
      match /entries/{entryId} {
        function validEntry(d) {
          return d.keys().hasOnly(['type', 'subtype', 'amount', 'signed', 'date', 'details',
                                   'attachments', 'voucherNo', 'signLinkId', 'signature', 'deleted',
                                   'deletedAt', 'auditId', 'legacyId',
                                   'createdAt', 'createdBy', 'updatedAt', 'updatedBy'])
            && d.type in ['invoice', 'payment', 'note']
            && d.amount is int && d.amount >= 0 && d.amount <= 100000000000
            && ((d.type == 'note' && d.amount == 0 && d.signed == 0)
                || (d.type == 'invoice' && d.amount > 0 && d.signed == d.amount)
                || (d.type == 'payment' && d.amount > 0 && d.signed == -d.amount))
            && isDate(d.date)
            && shortText(d.details, 500)
            && d.attachments is list && d.attachments.size() <= 5
            && (d.attachments.size() == 0
                || d.attachments.join(',').matches('^[A-Za-z0-9]{20}(,[A-Za-z0-9]{20})*$'))
            && (!('legacyId' in d) || d.legacyId is int)
            // A payment may be marked as a return (مرتجع) or a discount (خصم).
            && (!('subtype' in d) || (d.type == 'payment' && d.subtype in ['return', 'discount']))
            && d.deleted is bool;
        }
        function voucherAllocated(d) {
          // Payment vouchers take the next number from the shared counter, in
          // the same batch that bumps it.
          return d.voucherNo is int
            && d.voucherNo == getAfter(/databases/$(database)/documents/counters/vouchers).data.next
            && getAfter(/databases/$(database)/documents/counters/vouchers).data.next
               == get(/databases/$(database)/documents/counters/vouchers).data.next + 1;
        }
        function signatureFromLink(d) {
          // A signature can only be copied from a signed link of THIS entry.
          return d.signLinkId is string
            && d.signature.keys().hasOnly(['name', 'image', 'signedAt'])
            && get(/databases/$(database)/documents/signLinks/$(d.signLinkId)).data.status == 'signed'
            && get(/databases/$(database)/documents/signLinks/$(d.signLinkId)).data.entryId == entryId
            && get(/databases/$(database)/documents/signLinks/$(d.signLinkId)).data.accountId == accountId
            && d.signature.name == get(/databases/$(database)/documents/signLinks/$(d.signLinkId)).data.signerName
            && d.signature.image == get(/databases/$(database)/documents/signLinks/$(d.signLinkId)).data.signatureImage
            && d.signature.signedAt == get(/databases/$(database)/documents/signLinks/$(d.signLinkId)).data.signedAt
            // …and only if the recipient signed for exactly this amount/voucher.
            && get(/databases/$(database)/documents/signLinks/$(d.signLinkId)).data.amount == d.amount
            && get(/databases/$(database)/documents/signLinks/$(d.signLinkId)).data.voucherNo == d.get('voucherNo', null)
            // …and the link was issued after the entry's last change (an edit
            // after signing voids the signature; the old link cannot bring it back).
            && get(/databases/$(database)/documents/signLinks/$(d.signLinkId)).data.createdAt
               > resource.data.get('updatedAt', resource.data.createdAt);
        }
        function sameIdentity() {
          return request.resource.data.type == resource.data.type
            && request.resource.data.get('subtype', null) == resource.data.get('subtype', null)
            && request.resource.data.get('voucherNo', null) == resource.data.get('voucherNo', null)
            && request.resource.data.createdAt == resource.data.createdAt
            && request.resource.data.createdBy == resource.data.createdBy
            && request.resource.data.get('legacyId', null) == resource.data.get('legacyId', null);
        }
        function entryPath() { return 'accounts/' + accountId + '/entries/' + entryId; }
        function acct() { return /databases/$(database)/documents/accounts/$(accountId); }
        // Every create/edit/trash/restore moves the account's running totals in
        // the same write (not required until the account is initialised).
        function totalsMoved() {
          return !('balance' in get(acct()).data)
            || (getAfter(acct()).data.totalsAt == request.time
                && getAfter(acct()).data.totalsEntry == entryId);
        }
        function trashFlip() {
          return changed().hasOnly(['deleted', 'deletedAt', 'auditId', 'updatedAt', 'updatedBy'])
            && touched(request.resource.data)
            && audited(entryPath())
            && notified();
        }

        allow read: if canAccess(accountId);

        allow create: if canAccess(accountId)
          && validEntry(request.resource.data)
          && request.resource.data.deleted == false
          && !('signature' in request.resource.data)
          && !('signLinkId' in request.resource.data)
          && !('legacyId' in request.resource.data)
          && !('deletedAt' in request.resource.data)
          && !('auditId' in request.resource.data)
          && stamped(request.resource.data)
          && (request.resource.data.type != 'payment' || voucherAllocated(request.resource.data))
          && (request.resource.data.type == 'payment' || !('voucherNo' in request.resource.data))
          && totalsMoved();

        // Edit. Editing a signed voucher removes its signature (and link id):
        // a new link must be sent. Always audited; a signed voucher or an
        // invoice also notifies the managers.
        // (Cheap field checks come first in every rule: a batch has a budget of
        // 1000 evaluated expressions, and the role checks are the expensive part.)
        allow update: if resource.data.deleted == false
          && request.resource.data.deleted == false
          && !('deletedAt' in request.resource.data)
          && !changed().hasOnly(['signLinkId', 'signature', 'updatedAt', 'updatedBy'])
          && canAccess(accountId)
          && validEntry(request.resource.data)
          && sameIdentity()
          && !('signature' in request.resource.data)
          && (('signature' in resource.data)
              ? !('signLinkId' in request.resource.data)
              : request.resource.data.get('signLinkId', null) == resource.data.get('signLinkId', null))
          && touched(request.resource.data)
          && audited(entryPath())
          && ((!('signature' in resource.data) && resource.data.type != 'invoice') || notified())
          && totalsMoved();

        // Move to the trash (signed vouchers too): nothing else changes, so a
        // restore brings the entry back exactly as it was. Audited + notified.
        allow update: if resource.data.deleted == false
          && request.resource.data.deleted == true
          && request.resource.data.deletedAt == request.time
          && canAccess(accountId)
          && trashFlip()
          && totalsMoved();

        // Restore from the trash: owner and managers only.
        allow update: if resource.data.deleted == true
          && request.resource.data.deleted == false
          && !('deletedAt' in request.resource.data)
          && isManager()
          && trashFlip()
          && totalsMoved();

        // Attach the recipient's signature (copied from the signed link).
        allow update: if resource.data.type == 'payment'
          && resource.data.deleted == false
          && !('signature' in resource.data)
          && changed().hasOnly(['signLinkId', 'signature', 'updatedAt', 'updatedBy'])
          && canAccess(accountId)
          && signatureFromLink(request.resource.data)
          && touched(request.resource.data);

        allow delete: if false;
      }

      // ---------- attachments --------------------------------------------
      // A small thumbnail (≤ 60 KB) stays here for good; the original (≤ 300 KB)
      // is moved to the owner's Dropbox by the nightly job (Admin SDK), which
      // replaces `data` with a view link.
      match /attachments/{attId} {
        allow read: if canAccess(accountId);
        allow create: if canAccess(accountId)
          && request.resource.data.keys().hasOnly(['data', 'thumb', 'mime', 'size', 'entryId', 'createdAt', 'createdBy'])
          && request.resource.data.data is bytes
          && request.resource.data.data.size() <= 307200
          && request.resource.data.thumb is bytes
          && request.resource.data.thumb.size() <= 61440
          && request.resource.data.size == request.resource.data.data.size()
          && request.resource.data.mime in ['image/webp', 'image/jpeg']
          && request.resource.data.entryId is string
          && existsAfter(/databases/$(database)/documents/accounts/$(accountId)/entries/$(request.resource.data.entryId))
          && stamped(request.resource.data);
        allow update: if false;
        // No permanent delete for anyone (originals are also kept in Dropbox).
        allow delete: if false;
      }
    }

    // ---------- signing links ------------------------------------------------
    // The token (document id) is a 128-bit random value. A link is readable and
    // signable without login only while pending and before expiry (server
    // time); signing flips it to 'signed', after which it is dead.
    match /signLinks/{token} {
      function live() {
        return resource.data.status == 'pending'
          && request.time < resource.data.createdAt + duration.value(resource.data.ttlMinutes, 'm');
      }
      function accountAt(d) {
        return get(/databases/$(database)/documents/accounts/$(d.accountId)).data;
      }
      function entryAt(d) {
        return get(/databases/$(database)/documents/accounts/$(d.accountId)/entries/$(d.entryId)).data;
      }

      allow get: if live() || (isActive() && canAccess(resource.data.accountId));
      allow list: if isActive() && canAccess(resource.data.accountId);

      allow create: if isActive()
        && token.size() >= 22
        && canAccess(request.resource.data.accountId)
        && request.resource.data.keys().hasOnly(['accountId', 'entryId', 'accountName', 'accountPhone', 'logo',
                                                 'payerName', 'amount', 'amountWords', 'date', 'details',
                                                 'voucherNo', 'ttlMinutes', 'status', 'synced',
                                                 'createdAt', 'createdBy'])
        && request.resource.data.status == 'pending'
        && request.resource.data.synced == false
        && request.resource.data.ttlMinutes == settings().linkMinutes
        && entryAt(request.resource.data).type == 'payment'
        && entryAt(request.resource.data).deleted == false
        && !('subtype' in entryAt(request.resource.data))
        && !('signature' in entryAt(request.resource.data))
        && entryAt(request.resource.data).amount == request.resource.data.amount
        && entryAt(request.resource.data).voucherNo == request.resource.data.voucherNo
        && request.resource.data.date == entryAt(request.resource.data).date
        && request.resource.data.details == entryAt(request.resource.data).details
        && request.resource.data.payerName == settings().payerName
        && request.resource.data.accountName == accountAt(request.resource.data).name
        && request.resource.data.accountPhone == accountAt(request.resource.data).phone
        && request.resource.data.get('logo', null) == accountAt(request.resource.data).get('logo', null)
        && shortText(request.resource.data.amountWords, 300)
        && shortText(request.resource.data.details, 500)
        && (!('logo' in request.resource.data) || request.resource.data.logo == null
            || (request.resource.data.logo is bytes && request.resource.data.logo.size() <= 81920))
        && stamped(request.resource.data);

      // Recipient signs (no login): once, before expiry, only these fields.
      allow update: if live()
        && changed().hasOnly(['status', 'signerName', 'signatureImage', 'signedAt'])
        && request.resource.data.status == 'signed'
        && request.resource.data.signedAt == request.time
        && request.resource.data.signerName is string
        && request.resource.data.signerName.size() >= 2 && request.resource.data.signerName.size() <= 80
        && request.resource.data.signatureImage is string
        && request.resource.data.signatureImage.matches('^data:image/png;base64,[A-Za-z0-9+/=]+$')
        && request.resource.data.signatureImage.size() <= 61440;

      // Staff: revoke a pending link, or mark a signed one as synced.
      allow update: if isActive() && canAccess(resource.data.accountId)
        && ((resource.data.status == 'pending'
             && changed().hasOnly(['status']) && request.resource.data.status == 'revoked')
            || (resource.data.status == 'signed'
             && changed().hasOnly(['synced']) && request.resource.data.synced == true));

      allow delete: if false;
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
