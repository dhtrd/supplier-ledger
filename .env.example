# Firebase web config (public, but kept out of the repo). Set the same names as
# GitHub repository *variables* for CI/deploy.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
# App Check (approved hardening): reCAPTCHA v3 site key — public by design.
VITE_RECAPTCHA_SITE_KEY=
# Optional: connect to local emulators in dev
VITE_USE_EMULATORS=false
